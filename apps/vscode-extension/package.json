{
  "name": "testlens",
  "displayName": "Aetherexa TestLens",
  "description": "Test gap intelligence and smart related-test selection",
  "publisher": "aetherexa",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "main": "./out/extension.cjs",
  "activationEvents": [
    "onView:testlens.findings",
    "onCommand:testlens.analyze"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "testlens",
          "title": "TestLens",
          "icon": "resources/testlens.svg"
        }
      ]
    },
    "views": {
      "testlens": [
        {
          "id": "testlens.findings",
          "name": "Test Gaps"
        }
      ]
    },
    "commands": [
      {
        "command": "testlens.analyze",
        "title": "TestLens: Analyze Workspace"
      },
      {
        "command": "testlens.runRelated",
        "title": "TestLens: Run Related Tests"
      }
    ]
  }
}