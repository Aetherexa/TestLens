{
  "name": "testlens-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @aetherexa/testlens-core build && pnpm --filter testlens build",
    "typecheck": "pnpm --filter @aetherexa/testlens-core typecheck && pnpm --filter testlens typecheck",
    "test": "pnpm --filter @aetherexa/testlens-core test",
    "test:coverage": "pnpm --filter @aetherexa/testlens-core test:coverage",
    "check": "pnpm typecheck && pnpm test:coverage && pnpm build",
    "quality": "pnpm check",
    "package:vsix": "pnpm --filter testlens package:vsix"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "esbuild": "^0.25.9",
    "@vscode/vsce": "^4.0.0"
  }
}
